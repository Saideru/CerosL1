# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The stable public origin where this app is hosted (no path).
# Set this in Vercel to the production domain, not a deployment-specific preview URL.
# OAuth callbacks use this origin and must match the redirect URL registered with Whop.
APP_URL="MY_APP_URL"

# Supabase (Project Settings -> API). Required for sign-in, RBAC and trace logs.
# Set these in Vercel too: Project -> Settings -> Environment Variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Whop paywall (Vercel -> Settings -> Environment Variables). Server-side only: never prefix with VITE_.
WHOP_CLIENT_ID="app_5U4oncI8fM4PVZ"
WHOP_CLIENT_SECRET="from Whop -> Developer -> Apps -> CerosL Calculator Login -> OAuth"
WHOP_API_KEY="from Whop -> Developer -> API keys (Kam-team company key)"
WHOP_PRODUCT_ID="prod_PEb4zKg6prF6m"
SESSION_SECRET="any random string, 32+ characters"
